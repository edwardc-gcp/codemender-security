{
  "codemender-safety-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash ./scripts/pre_tool_guard.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
