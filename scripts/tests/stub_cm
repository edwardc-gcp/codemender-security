#!/usr/bin/env bash
# Stub CodeMender CLI for the plugin's regression tests: no network access and no model calls.
#   STUB_FIX_MODE=patch|reset-then-patch|patch-with-artifacts|fail   behavior of `cm fix` (default: patch)
#   STUB_LOG=<file>                              append every invocation's arguments to this file
if [ -n "${STUB_LOG:-}" ]; then
  printf '%s\n' "$*" >> "${STUB_LOG}"
fi

case "${1:-}" in
  report)
    printf '[{"finding_id": "f-001", "status": "OPEN", "severity": "HIGH", "title": "SQL injection in app.py", "file_path": "%s/app.py", "start_line": 1, "end_line": 1}]\n' "$(pwd)"
    ;;
  fix)
    case "${STUB_FIX_MODE:-patch}" in
      patch)
        sed -i.bak 's/UNSAFE/SAFE/' app.py && rm -f app.py.bak
        ;;
      reset-then-patch)
        # What Phase 0 observed in cm 0.16.0: `cm fix` resets its workspace before patching.
        git checkout -q HEAD -- . && git clean -fdq
        sed -i.bak 's/UNSAFE/SAFE/' app.py && rm -f app.py.bak
        ;;
      patch-with-artifacts)
        # Side effects seen in Phase 0: ignore-file edits, a generated .gitignore, a new helper, and stray output.
        sed -i.bak 's/UNSAFE/SAFE/' app.py && rm -f app.py.bak
        printf '.exploit/\n' >> .gitignore
        mkdir -p lib
        printf '\n# CodeMender enforced ignores\nnode_modules\n.exploit/\n' > lib/.gitignore
        echo 'def clean(value): return value' > sanitize.py
        echo 'build output' > fix.log
        ;;
      fail)
        echo "# half-applied patch" >> app.py
        exit 1
        ;;
    esac
    ;;
  --version)
    echo "cm version 0.16.0 (stub)"
    ;;
  find)
    # Diff-mode emulation: STUB_FIND_MODE=clean|findings|error; STUB_DIFF_SNAPSHOT records what `git diff HEAD` sees.
    out=""
    prev=""
    for arg in "$@"; do
      if [ "${prev}" = "--output" ]; then
        out="${arg}"
      fi
      prev="${arg}"
    done
    if [ -n "${STUB_DIFF_SNAPSHOT:-}" ]; then
      git diff --name-only HEAD > "${STUB_DIFF_SNAPSHOT}"
    fi
    case "${STUB_FIND_MODE:-clean}" in
      clean)
        if [ -n "${out}" ]; then printf '[]\n' > "${out}"; fi
        exit 0
        ;;
      findings)
        if [ -n "${out}" ]; then
          printf '[{"finding_id": "f-100abcd", "severity": "HIGH", "status": "OPEN", "title": "SQL injection in app.py", "file_path": "%s/app.py", "start_line": 1, "end_line": 1}, {"finding_id": "f-200abcd", "severity": "HIGH", "status": "OPEN", "title": "[LEGACY / UNTOUCHED] Command injection in legacy.py", "file_path": "%s/legacy.py", "start_line": 3, "end_line": 3}]\n' "$(pwd)" "$(pwd)" > "${out}"
        fi
        exit 1
        ;;
      error)
        echo "Error: retrieving VCS diff: git diff failed: exit status 128" >&2
        exit 1
        ;;
    esac
    ;;
  *)
    exit 0
    ;;
esac
